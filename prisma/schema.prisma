generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DuracaoCorte {
  MIN_15
  MIN_30
  MIN_45
  MIN_60
}

enum StatusAgendamento {
  AGENDADO
  CANCELADO
  CONCLUIDO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

enum MotivoBloqueio {
  ALMOCO
  COMPROMISSO
  OUTRO
}